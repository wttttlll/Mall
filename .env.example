# 复制为 .env 后按需修改；.env 不应提交到 Git。
# 这些变量供 docker compose 使用。应用运行时默认值与下面一致，
# 如需修改应用连接信息，请同时设置应用进程的环境变量。

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=mallagent
MYSQL_USER=mallagent
MYSQL_PASSWORD=mallagent
MYSQL_PORT=3307

REDIS_PORT=6379

RABBITMQ_USER=mallagent
RABBITMQ_PASSWORD=mallagent
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
