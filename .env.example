# 复制为 .env 后使用：Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密码或生产密钥。
# 下面的值是本地演示默认值，不是生产密钥；生产环境必须全部替换。
# 注意：MySQL 数据卷已存在时，必须沿用创建数据卷时设置的 MySQL 密码。

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=mallagent
MYSQL_USER=mallagent
MYSQL_PASSWORD=mallagent
MYSQL_PORT=3307

REDIS_PORT=6379

RABBITMQ_USER=mallagent
RABBITMQ_PASSWORD=mallagent
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 本地演示 JWT 密钥；生产环境必须替换为至少 32 字节的随机值。
JWT_SECRET=mallagent-local-dev-secret-change-me-0123456789abcdef
# 仅首次初始化管理员时生效；已有 admin 账号不会被重置。
# 默认值为本地演示凭据，生产环境必须修改。
ADMIN_INIT_PASSWORD=Admin@123456

# 本地演示默认开启 Swagger；生产或局域网部署建议设为 false。
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Docker 完整部署对外端口，避免与本地 8080/5173 冲突。
DOCKER_BACKEND_PORT=8081
FRONTEND_PORT=8088

# 如 Docker Hub 不可直接访问，可改为可用的镜像站地址。
MAVEN_IMAGE=maven:3.9-eclipse-temurin-21
JRE_IMAGE=eclipse-temurin:21-jre-jammy
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
